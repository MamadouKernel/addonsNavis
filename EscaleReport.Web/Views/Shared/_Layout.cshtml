@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
    bool IsActiveAction(string c, string a) => IsActive(c) && string.Equals(action, a, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EscaleReport</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <!-- ============ BARRE MOBILE (hamburger) ============ -->
    <div class="flex items-center justify-between border-b border-slate-200 bg-white px-4 py-3 md:hidden">
        <button id="sidebarOpen" type="button" aria-label="Ouvrir le menu"
                class="-ml-2 rounded-lg p-2 text-slate-600 hover:bg-slate-100">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <span class="text-sm font-bold text-slate-900">EscaleReport</span>
        <span class="w-9"></span>
    </div>

    <div class="flex min-h-screen md:min-h-screen">
        <!-- Overlay (mobile uniquement, ferme le tiroir au clic) -->
        <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-slate-900/50 md:hidden"></div>

        <!-- ============ SIDEBAR ============
             Tiroir mobile géré par un simple toggle de la classe "hidden" (display none/flex) —
             plus robuste et vérifiable qu'un translate CSS animé, priorité donnée à la
             correction fonctionnelle sur l'effet visuel. -->
        <aside id="sidebar"
               class="fixed inset-y-0 left-0 z-40 hidden w-72 max-w-[85vw] flex-col
                      bg-gradient-to-b from-slate-900 to-slate-950 px-4 py-6
                      md:static md:z-auto md:flex md:w-64 md:max-w-none">
            <div class="mb-8 flex items-center gap-3 px-2">
                <div class="grid h-10 w-10 flex-none place-items-center rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 shadow-soft">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 17l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1" />
                        <path d="M5 17V9l7-4 7 4v8" />
                        <path d="M12 5v12" />
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-bold leading-tight text-white">EscaleReport</div>
                    <div class="text-[10px] font-medium uppercase tracking-wider text-slate-400">Côte d'Ivoire Terminal</div>
                </div>
                <button id="sidebarClose" type="button" aria-label="Fermer le menu" class="rounded-lg p-1.5 text-slate-400 hover:bg-white/10 hover:text-white md:hidden">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <nav class="flex flex-1 flex-col gap-1">
                <a asp-controller="Escales" asp-action="Index" class="sidebar-link @(IsActive("Escales") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M3 9h18M8 4v5" />
                    </svg>
                    Escales
                </a>
                <a asp-controller="Dispatch" asp-action="Sts" class="sidebar-link @(IsActiveAction("Dispatch", "Sts") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M4 20V10l8-6 8 6v10" />
                        <path d="M9 20v-6h6v6" />
                    </svg>
                    Dispatch STS
                </a>
                <a asp-controller="Dispatch" asp-action="Tt" class="sidebar-link @(IsActiveAction("Dispatch", "Tt") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="1" y="9" width="15" height="9" rx="1" />
                        <path d="M16 12h3l3 3v3h-6z" />
                        <circle cx="5.5" cy="20" r="1.5" />
                        <circle cx="17.5" cy="20" r="1.5" />
                    </svg>
                    Dispatch TT
                </a>
                <a asp-controller="Dispatch" asp-action="Rtg" class="sidebar-link @(IsActiveAction("Dispatch", "Rtg") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M3 9h18M9 21V9" />
                    </svg>
                    Dispatch RTG
                </a>
                <a asp-controller="Dispatch" asp-action="AutresEngins" class="sidebar-link @(IsActiveAction("Dispatch", "AutresEngins") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 3" />
                    </svg>
                    Autres engins
                </a>
                <a asp-controller="Cargo" asp-action="Index" class="sidebar-link @(IsActive("Cargo") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M21 8L12 4 3 8l9 4 9-4z" />
                        <path d="M3 8v8l9 4 9-4V8" />
                        <path d="M12 12v8" />
                    </svg>
                    Cargo Control
                </a>
            </nav>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <div class="mt-auto border-t border-white/10 pt-4">
                    <div class="flex items-center gap-3 px-2 pb-3">
                        <div class="grid h-8 w-8 flex-none place-items-center rounded-full bg-white/10 text-xs font-bold text-white">
                            @(User.Identity!.Name!.Length > 0 ? User.Identity!.Name![0].ToString().ToUpper() : "?")
                        </div>
                        <div class="truncate text-xs font-semibold text-slate-200">@User.Identity!.Name</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-link w-full justify-start">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <path d="M16 17l5-5-5-5" />
                                <path d="M21 12H9" />
                            </svg>
                            Déconnexion
                        </button>
                    </form>
                </div>
            }
        </aside>

        <!-- ============ CONTENU ============ -->
        <div class="min-w-0 flex-1">
            <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 md:px-8 md:py-10">
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        (function () {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            var openBtn = document.getElementById('sidebarOpen');
            var closeBtn = document.getElementById('sidebarClose');

            // Style inline (pas de classList) pour la sidebar : garantit qu'elle passe en
            // display:flex sous md sans dépendre de l'ordre de génération des classes
            // "hidden"/"md:flex" par Tailwind — l'un ou l'autre gagnerait sinon selon un
            // ordre interne non garanti si les deux étaient posées en classe en même temps.
            function openSidebar() {
                sidebar.style.display = 'flex';
                overlay.classList.remove('hidden');
            }
            function closeSidebar() {
                sidebar.style.display = '';
                overlay.classList.add('hidden');
            }

            openBtn && openBtn.addEventListener('click', openSidebar);
            closeBtn && closeBtn.addEventListener('click', closeSidebar);
            overlay && overlay.addEventListener('click', closeSidebar);
        })();
    </script>
</body>
</html>
