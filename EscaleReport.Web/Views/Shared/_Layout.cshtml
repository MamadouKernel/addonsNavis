@inject ICurrentUserService CurrentUser
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
    bool IsActiveAction(string c, string a) => IsActive(c) && string.Equals(action, a, StringComparison.OrdinalIgnoreCase);
    var theme = Context.Request.Cookies["theme"] == "dark" ? "dark" : "light";
    var palette = PaletteCatalog.FromCookie(Context.Request.Cookies["palette"]);
    var canViewOperations = ModuleAccess.CanViewDispatch(CurrentUser, "STS")
        || ModuleAccess.CanViewDispatch(CurrentUser, "TT")
        || ModuleAccess.CanViewDispatch(CurrentUser, "RTG")
        || ModuleAccess.CanViewDispatch(CurrentUser, "Autres engins")
        || CurrentUser.IsInRole("Dispatcher");
    var canViewPlanning = ModuleAccess.CanViewCargo(CurrentUser)
        || ModuleAccess.CanViewYard(CurrentUser)
        || ModuleAccess.CanViewItt(CurrentUser);
    var canViewPilotage = ModuleAccess.CanViewCoordination(CurrentUser)
        || ModuleAccess.CanViewNotifications(CurrentUser)
        || ModuleAccess.CanViewReporting(CurrentUser)
        || ModuleAccess.CanViewStatistics(CurrentUser);
    var canViewAdministration = ModuleAccess.CanViewSettings(CurrentUser)
        || ModuleAccess.CanViewUsers(CurrentUser)
        || ModuleAccess.CanViewAudit(CurrentUser);
}
<!DOCTYPE html>
<html lang="fr" data-theme="@theme" data-palette="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EscaleReport</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen antialiased">
    <div class="min-h-screen">
        <!-- Overlay (mobile uniquement, ferme le tiroir au clic) -->
        <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-black/50 md:hidden"></div>

        <!-- ============ SIDEBAR ============
             Tiroir mobile géré par un simple toggle de la classe "hidden" (display none/flex) —
             plus robuste et vérifiable qu'un translate CSS animé, priorité donnée à la
             correction fonctionnelle sur l'effet visuel. -->
        <aside id="sidebar" hidden aria-hidden="true"
               class="fixed inset-y-0 left-0 z-40 hidden w-72 max-w-[85vw] flex-col overflow-hidden px-4 py-6
                      md:relative md:z-auto md:flex md:w-64 md:max-w-none"
               style="background:linear-gradient(175deg, var(--ink) 0%, var(--steel) 65%, var(--steel-2) 100%)">
            <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-16 h-56 w-56 rounded-full opacity-30 blur-3xl" style="background:var(--sea)"></div>
            <div class="relative mb-8 flex items-center gap-3 px-2">
                <div class="animate-floaty grid h-10 w-10 flex-none place-items-center rounded-xl shadow-soft" style="background:linear-gradient(135deg, var(--amber), var(--amber-soft))">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#04262a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 17l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1" />
                        <path d="M5 17V9l7-4 7 4v8" />
                        <path d="M12 5v12" />
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="text-sm font-bold leading-tight text-white">EscaleReport</div>
                    <div class="text-[10px] font-medium uppercase tracking-wider" style="color:rgba(255,255,255,.55)">Côte d'Ivoire Terminal</div>
                </div>
                <button id="sidebarClose" type="button" aria-label="Fermer le menu" class="rounded-lg p-1.5 text-white/60 hover:bg-white/10 hover:text-white md:hidden">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <nav class="flex flex-1 flex-col gap-1">
                @if (ModuleAccess.CanViewEscales(CurrentUser))
                {
                <a asp-controller="Escales" asp-action="Index" class="sidebar-link @(IsActive("Escales") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M3 9h18M8 4v5" />
                    </svg>
                    Escales
                </a>
                }
                @if (ModuleAccess.CanViewDispatch(CurrentUser, "STS"))
                {
                <a asp-controller="Dispatch" asp-action="Sts" class="sidebar-link @(IsActiveAction("Dispatch", "Sts") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M4 20V10l8-6 8 6v10" />
                        <path d="M9 20v-6h6v6" />
                    </svg>
                    Dispatch STS
                </a>
                }
                @if (ModuleAccess.CanViewDispatch(CurrentUser, "TT"))
                {
                <a asp-controller="Dispatch" asp-action="Tt" class="sidebar-link @(IsActiveAction("Dispatch", "Tt") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="1" y="9" width="15" height="9" rx="1" />
                        <path d="M16 12h3l3 3v3h-6z" />
                        <circle cx="5.5" cy="20" r="1.5" />
                        <circle cx="17.5" cy="20" r="1.5" />
                    </svg>
                    Dispatch TT
                </a>
                }
                @if (ModuleAccess.CanViewDispatch(CurrentUser, "RTG"))
                {
                <a asp-controller="Dispatch" asp-action="Rtg" class="sidebar-link @(IsActiveAction("Dispatch", "Rtg") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <path d="M3 9h18M9 21V9" />
                    </svg>
                    Dispatch RTG
                </a>
                }
                @if (ModuleAccess.CanViewDispatch(CurrentUser, "Autres engins"))
                {
                <a asp-controller="Dispatch" asp-action="AutresEngins" class="sidebar-link @(IsActiveAction("Dispatch", "AutresEngins") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 3" />
                    </svg>
                    Autres engins
                </a>
                }
                @if (CurrentUser.IsInRole("Dispatcher"))
                {
                <a asp-controller="Account" asp-action="ChooseDispatchPost" class="sidebar-link @(IsActiveAction("Account", "ChooseDispatchPost") ? "active" : "")">
                    <span class="flex-none text-lg" aria-hidden="true">⇄</span>
                    Poste du jour
                </a>
                }                @if (ModuleAccess.CanViewCargo(CurrentUser))
                {
                <a asp-controller="Cargo" asp-action="Index" class="sidebar-link @(IsActive("Cargo") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M21 8L12 4 3 8l9 4 9-4z" />
                        <path d="M3 8v8l9 4 9-4V8" />
                        <path d="M12 12v8" />
                    </svg>
                    Cargo Control
                </a>
                }
                @if (ModuleAccess.CanViewYard(CurrentUser))
                {
                <a asp-controller="YardPlanner" asp-action="Index" class="sidebar-link @(IsActive("YardPlanner") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M3 10h18M9 10v10" />
                    </svg>
                    Yard Planner
                </a>
                }
                @if (ModuleAccess.CanViewCoordination(CurrentUser))
                {
                <a asp-controller="Coordination" asp-action="Index" class="sidebar-link @(IsActive("Coordination") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M12 2v4M12 18v4M4.2 4.2l2.8 2.8M17 17l2.8 2.8M2 12h4M18 12h4M4.2 19.8L7 17M17 7l2.8-2.8" />
                    </svg>
                    Coordinateur
                </a>
                }
                @if (ModuleAccess.CanViewItt(CurrentUser))
                {
                <a asp-controller="Itt" asp-action="Index" class="sidebar-link @(IsActive("Itt") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M7 7h10M7 7l3-3M7 7l3 3M17 17H7M17 17l-3 3M17 17l-3-3" />
                    </svg>
                    ITT Controller
                </a>
                }
                @if (ModuleAccess.CanViewNotifications(CurrentUser))
                {
                <a asp-controller="Notifications" asp-action="Index" class="sidebar-link @(IsActive("Notifications") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    Alertes
                </a>
                }
                @if (ModuleAccess.CanViewReporting(CurrentUser))
                {
                <a asp-controller="Reporting" asp-action="Index" class="sidebar-link @(IsActive("Reporting") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h6" />
                    </svg>
                    Rapport de shift
                </a>
                }
                @if (ModuleAccess.CanViewSettings(CurrentUser))
                {
                <a asp-controller="Parametrage" asp-action="Index" class="sidebar-link @(IsActive("Parametrage") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                    Paramétrage
                </a>
                }
                @if (ModuleAccess.CanViewUsers(CurrentUser))
                {
                <a asp-controller="Users" asp-action="Index" class="sidebar-link @(IsActive("Users") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                    Comptes &amp; permissions
                </a>
                }
                @if (ModuleAccess.CanViewAudit(CurrentUser))
                {
                <a asp-controller="Audit" asp-action="Index" class="sidebar-link @(IsActive("Audit") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
                    </svg>
                    Journal d'audit
                </a>
                }
                @if (ModuleAccess.CanViewStatistics(CurrentUser))
                {
                <a asp-controller="Statistics" asp-action="Index" class="sidebar-link @(IsActive("Statistics") ? "active" : "")">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                        <path d="M3 3v18h18" /><path d="M18.7 8l-5.1 5.1-2.8-2.8L7 14" />
                    </svg>
                    Indicateurs
                </a>
                }
            </nav>
        </aside>

        <!-- ============ CONTENU ============ -->
        <div class="min-w-0">
            <!-- ============ NAVBAR (hamburger mobile + theme + profil) ============
                 Visible a toutes les tailles, contrairement a lancienne barre reservee
                 au mobile : regroupe le theme et le profil dans un seul menu clair
                 plutot que des boutons empiles en bas de la sidebar. -->
            <header class="app-topbar border-b px-4 py-3 md:px-6" style="background:var(--card);border-color:var(--line)">
                <a asp-controller="Dashboard" asp-action="Index" class="navbar-brand" aria-label="EscaleReport — accueil">
                    <span class="navbar-brand-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1" /><path d="M5 17V9l7-4 7 4v8" /><path d="M12 5v12" /></svg>
                    </span>
                    <span><strong>EscaleReport</strong><small>Côte d'Ivoire Terminal</small></span>
                </a>

                <nav class="navbar-links" aria-label="Navigation principale">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-menu-trigger @(IsActive("Dashboard") ? "active" : "")" aria-label="Accueil" title="Accueil">⌂</a>
                    @if (ModuleAccess.CanViewEscales(CurrentUser))
                    {
                        <a asp-controller="Escales" asp-action="Index" class="nav-menu-trigger @(IsActive("Escales") ? "active" : "")">Escales</a>
                    }
                    @if (canViewOperations)
                    {
                        <div class="nav-menu">
                            <button type="button" data-dropdown-toggle="operationsMenu" class="nav-menu-trigger @(IsActive("Dispatch") || IsActiveAction("Account", "ChooseDispatchPost") ? "active" : "")" aria-haspopup="true" aria-expanded="false">Opérations <span aria-hidden="true">⌄</span></button>
                            <div id="operationsMenu" class="dropdown-panel nav-dropdown-panel hidden">
                                @if (ModuleAccess.CanViewDispatch(CurrentUser, "STS")) { <a asp-controller="Dispatch" asp-action="Sts" class="dropdown-item">Dispatch STS</a> }
                                @if (ModuleAccess.CanViewDispatch(CurrentUser, "TT")) { <a asp-controller="Dispatch" asp-action="Tt" class="dropdown-item">Dispatch TT</a> }
                                @if (ModuleAccess.CanViewDispatch(CurrentUser, "RTG")) { <a asp-controller="Dispatch" asp-action="Rtg" class="dropdown-item">Dispatch RTG</a> }
                                @if (ModuleAccess.CanViewDispatch(CurrentUser, "Autres engins")) { <a asp-controller="Dispatch" asp-action="AutresEngins" class="dropdown-item">Autres engins</a> }
                                @if (CurrentUser.IsInRole("Dispatcher")) { <a asp-controller="Account" asp-action="ChooseDispatchPost" class="dropdown-item">Poste du jour</a> }
                            </div>
                        </div>
                    }
                    @if (canViewPlanning)
                    {
                        <div class="nav-menu">
                            <button type="button" data-dropdown-toggle="planningMenu" class="nav-menu-trigger @(IsActive("Cargo") || IsActive("YardPlanner") || IsActive("Itt") ? "active" : "")" aria-haspopup="true" aria-expanded="false">Planification <span aria-hidden="true">⌄</span></button>
                            <div id="planningMenu" class="dropdown-panel nav-dropdown-panel hidden">
                                @if (ModuleAccess.CanViewCargo(CurrentUser)) { <a asp-controller="Cargo" asp-action="Index" class="dropdown-item">Cargo Control</a> }
                                @if (ModuleAccess.CanViewYard(CurrentUser)) { <a asp-controller="YardPlanner" asp-action="Index" class="dropdown-item">Yard Planner</a> }
                                @if (ModuleAccess.CanViewItt(CurrentUser)) { <a asp-controller="Itt" asp-action="Index" class="dropdown-item">ITT Controller</a> }
                            </div>
                        </div>
                    }
                    @if (canViewPilotage)
                    {
                        <div class="nav-menu">
                            <button type="button" data-dropdown-toggle="pilotageMenu" class="nav-menu-trigger @(IsActive("Coordination") || IsActive("Notifications") || IsActive("Reporting") || IsActive("Statistics") ? "active" : "")" aria-haspopup="true" aria-expanded="false">Pilotage <span aria-hidden="true">⌄</span></button>
                            <div id="pilotageMenu" class="dropdown-panel nav-dropdown-panel hidden">
                                @if (ModuleAccess.CanViewCoordination(CurrentUser)) { <a asp-controller="Coordination" asp-action="Index" class="dropdown-item">Coordination</a> }
                                @if (ModuleAccess.CanViewNotifications(CurrentUser)) { <a asp-controller="Notifications" asp-action="Index" class="dropdown-item">Alertes</a> }
                                @if (ModuleAccess.CanViewReporting(CurrentUser)) { <a asp-controller="Reporting" asp-action="Index" class="dropdown-item">Rapport de shift</a> }
                                @if (ModuleAccess.CanViewStatistics(CurrentUser)) { <a asp-controller="Statistics" asp-action="Index" class="dropdown-item">Indicateurs</a> }
                            </div>
                        </div>
                    }
                    @if (canViewAdministration)
                    {
                        <div class="nav-menu">
                            <button type="button" data-dropdown-toggle="administrationMenu" class="nav-menu-trigger @(IsActive("Parametrage") || IsActive("Users") || IsActive("Audit") ? "active" : "")" aria-haspopup="true" aria-expanded="false">Administration <span aria-hidden="true">⌄</span></button>
                            <div id="administrationMenu" class="dropdown-panel nav-dropdown-panel hidden">
                                @if (ModuleAccess.CanViewSettings(CurrentUser)) { <a asp-controller="Parametrage" asp-action="Index" class="dropdown-item">Paramétrage</a> }
                                @if (ModuleAccess.CanViewUsers(CurrentUser)) { <a asp-controller="Users" asp-action="Index" class="dropdown-item">Comptes &amp; permissions</a> }
                                @if (ModuleAccess.CanViewAudit(CurrentUser)) { <a asp-controller="Audit" asp-action="Index" class="dropdown-item">Journal d'audit</a> }
                            </div>
                        </div>
                    }
                </nav>

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="ml-auto flex items-center gap-1.5">
                        <form asp-controller="Theme" asp-action="Toggle" method="post">
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button type="submit" class="topbar-icon-btn" aria-label="Basculer le mode sombre/clair" title="Basculer le mode sombre/clair">
                                @if (theme == "dark")
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
                                }
                                else
                                {
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                                }
                            </button>
                        </form>

                        <div class="relative">
                            <button type="button" data-dropdown-toggle="userMenu" class="user-menu-trigger" aria-haspopup="true" aria-expanded="false">
                                <div class="user-avatar">@(User.Identity!.Name!.Length > 0 ? User.Identity!.Name![0].ToString().ToUpper() : "?")</div>
                                <span class="hidden text-sm font-semibold sm:block" style="color:var(--ink)">@User.Identity!.Name</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-soft)"><path d="m6 9 6 6 6-6" /></svg>
                            </button>
                            <div id="userMenu" class="dropdown-panel hidden">
                                <a asp-controller="Profile" asp-action="Index" class="dropdown-item">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                    Mon profil
                                </a>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item danger">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                            <path d="M16 17l5-5-5-5" />
                                            <path d="M21 12H9" />
                                        </svg>
                                        Déconnexion
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </header>

            <main class="app-main mx-auto max-w-6xl px-4 py-6 sm:px-6 md:px-8 md:py-10" id="mainContent">
                @if (TempData["Error"] is string globalError)
                {
                    <div class="mb-6 alert-error">@globalError</div>
                }
                @if (TempData["Success"] is string globalSuccess)
                {
                    <div class="mb-6 alert-success">@globalSuccess</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script nonce="@Context.GetOrCreateCspNonce()">
        (function () {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            var openBtn = document.getElementById('sidebarOpen');
            var closeBtn = document.getElementById('sidebarClose');

            // Style inline (pas de classList) pour la sidebar : garantit qu'elle passe en
            // display:flex sous md sans dépendre de l'ordre de génération des classes
            // "hidden"/"md:flex" par Tailwind — l'un ou l'autre gagnerait sinon selon un
            // ordre interne non garanti si les deux étaient posées en classe en même temps.
            function openSidebar() {
                sidebar.style.display = 'flex';
                overlay.classList.remove('hidden');
            }
            function closeSidebar() {
                sidebar.style.display = '';
                overlay.classList.add('hidden');
            }

            openBtn && openBtn.addEventListener('click', openSidebar);
            closeBtn && closeBtn.addEventListener('click', closeSidebar);
            overlay && overlay.addEventListener('click', closeSidebar);

            // Gestionnaires délégués génériques (CDC §27, CSP sans 'unsafe-inline' sur
            // script-src) : remplacent les attributs onclick/onchange inline, qui ne
            // s'exécuteraient plus sous une CSP à base de nonce.
            document.addEventListener('change', function (e) {
                if (e.target.matches('.js-auto-submit')) {
                    e.target.form.submit();
                }
            });
            document.addEventListener('click', function (e) {
                var openTrigger = e.target.closest('[data-dialog-open]');
                if (openTrigger) {
                    var dialog = document.getElementById(openTrigger.dataset.dialogOpen);
                    dialog && dialog.showModal();
                    return;
                }
                var closeTrigger = e.target.closest('[data-dialog-close]');
                if (closeTrigger) {
                    var dialogToClose = document.getElementById(closeTrigger.dataset.dialogClose);
                    dialogToClose && dialogToClose.close();
                    return;
                }
                var row = e.target.closest('.js-row-link');
                if (row) {
                    location.href = row.dataset.href;
                    return;
                }

                // Menus déroulants de la navbar et du profil : un seul ouvert à la fois, fermé
                // au clic extérieur — pas de dépendance à <dialog> ici car le menu doit
                // rester ancré sous son déclencheur plutôt que centré à l'écran.
                var dropdownTrigger = e.target.closest('[data-dropdown-toggle]');
                document.querySelectorAll('.dropdown-panel').forEach(function (panel) {
                    if (!dropdownTrigger || panel.id !== dropdownTrigger.dataset.dropdownToggle) {
                        panel.classList.add('hidden');
                        var owner = document.querySelector('[data-dropdown-toggle="' + panel.id + '"]');
                        owner && owner.setAttribute('aria-expanded', 'false');
                    }
                });
                if (dropdownTrigger) {
                    var target = document.getElementById(dropdownTrigger.dataset.dropdownToggle);
                    if (target) {
                        target.classList.toggle('hidden');
                        dropdownTrigger.setAttribute('aria-expanded', String(!target.classList.contains('hidden')));
                    }
                }
            });
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                document.querySelectorAll('.dropdown-panel').forEach(function (panel) { panel.classList.add('hidden'); });
                document.querySelectorAll('[data-dropdown-toggle]').forEach(function (trigger) { trigger.setAttribute('aria-expanded', 'false'); });
            });

            // Pagination uniforme des petites tables qui ne nécessitent pas une nouvelle
            // requête serveur. Les tables volumineuses conservent le composant Razor paginé.
            document.querySelectorAll('table[data-client-pagination]').forEach(function (table, tableIndex) {
                var body = table.tBodies[0];
                if (!body) return;
                var rows = Array.from(body.rows).filter(function (row) { return !row.querySelector('td[colspan]'); });
                var pageSize = Math.max(1, parseInt(table.dataset.pageSize || '10', 10));
                var page = 1;
                var pager = document.createElement('nav');
                pager.className = 'client-pager';
                pager.setAttribute('aria-label', 'Pagination du tableau ' + (tableIndex + 1));
                var summary = document.createElement('span');
                var actions = document.createElement('div');
                var previous = document.createElement('button');
                var nextPage = document.createElement('button');
                previous.type = nextPage.type = 'button';
                previous.className = nextPage.className = 'client-pager-button';
                previous.innerHTML = '<span aria-hidden="true">‹</span><span>Précédent</span>';
                nextPage.innerHTML = '<span>Suivant</span><span aria-hidden="true">›</span>';
                actions.append(previous, nextPage);
                pager.append(summary, actions);
                (table.closest('.table-shell') || table).insertAdjacentElement('afterend', pager);

                function render() {
                    var eligible = rows.filter(function (row) { return row.dataset.filteredOut !== 'true'; });
                    var totalPages = Math.max(1, Math.ceil(eligible.length / pageSize));
                    page = Math.min(page, totalPages);
                    var start = (page - 1) * pageSize;
                    rows.forEach(function (row) { row.hidden = true; });
                    eligible.slice(start, start + pageSize).forEach(function (row) { row.hidden = false; });
                    summary.textContent = eligible.length + ' résultat(s) — page ' + page + ' sur ' + totalPages;
                    previous.disabled = page === 1;
                    nextPage.disabled = page === totalPages;
                    pager.hidden = eligible.length <= pageSize;
                }
                previous.addEventListener('click', function () { page--; render(); table.scrollIntoView({ behavior:'smooth', block:'nearest' }); });
                nextPage.addEventListener('click', function () { page++; render(); table.scrollIntoView({ behavior:'smooth', block:'nearest' }); });
                table.addEventListener('tablefilterchange', function () { page = 1; render(); });
                render();
            });
        })();
    </script>
</body>
</html>
