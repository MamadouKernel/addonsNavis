@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="error-page" role="alert" aria-labelledby="error-title">
    <div class="error-code" aria-hidden="true">@Model.StatusCode</div>
    <div class="error-content">
        <span class="error-eyebrow">EscaleReport · Centre d'assistance</span>
        <h1 id="error-title">@Model.Title</h1>
        <p>@Model.Message</p>
        <div class="error-actions">
            <a href="@Model.ActionUrl" class="btn-primary">@Model.ActionLabel</a>
            @if (Model.CanRetry)
            {
                <button type="button" class="btn-secondary" data-page-reload>Réessayer</button>
            }
        </div>
        @if (Model.ShowRequestId)
        {
            <div class="error-reference">
                <span>Référence diagnostic</span>
                <code>@Model.RequestId</code>
                <small>Communiquez cette référence au support si le problème persiste.</small>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script nonce="@Context.GetOrCreateCspNonce()">
        document.querySelector('[data-page-reload]')?.addEventListener('click', function () { location.reload(); });
    </script>
}
