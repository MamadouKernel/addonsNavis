@model EscaleReport.Web.Models.VerifyMfaViewModel
@{
    ViewData["Title"] = "Vérification de sécurité";
    Layout = null;
    var theme = Context.Request.Cookies["theme"] == "dark" ? "dark" : "light";
    var palette = PaletteCatalog.FromCookie(Context.Request.Cookies["palette"]);
}
<!DOCTYPE html>
<html lang="fr" data-theme="@theme" data-palette="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vérification - EscaleReport</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen items-center justify-center px-4 py-10" style="background:linear-gradient(135deg,var(--ink),var(--steel))">
    <main class="w-full max-w-md rounded-2xl p-8" style="background:var(--card);box-shadow:var(--shadow-soft-lg)">
        <div class="mb-6 grid h-14 w-14 place-items-center rounded-2xl" style="background:var(--amber-soft);color:var(--ink)" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </div>
        <p class="field-label">Protection Administrateur IT</p>
        <h1 class="mb-2 text-2xl font-bold" style="color:var(--ink)">Vérifiez votre identité</h1>
        <p class="mb-6" style="color:var(--text-soft)">Un code à 6 chiffres a été envoyé à <strong>@Model.MaskedEmail</strong>.</p>
        @if (TempData["Success"] is string success) { <div class="alert-success mb-4">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert-error mb-4">@error</div> }
        <form asp-action="VerifyMfa" method="post" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="alert-error"></div>
            <div>
                <label asp-for="Code" class="field-label"></label>
                <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus class="input-field text-center text-2xl tracking-[.45em]" />
            </div>
            <button type="submit" class="btn-primary w-full">Valider et continuer</button>
        </form>
        <form asp-action="ResendMfa" method="post" class="mt-4 text-center">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="btn-link">Renvoyer un code</button>
        </form>
    </main>
</body>
</html>
