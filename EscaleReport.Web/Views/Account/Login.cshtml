@model EscaleReport.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = null;
    var theme = Context.Request.Cookies["theme"] == "dark" ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="fr" data-theme="@theme" class="overflow-x-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion - EscaleReport</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-10"
      style="background:linear-gradient(120deg, var(--ink) 0%, var(--steel) 55%, var(--steel-2) 100%); background-size:220% 220%; animation:hdrShift 18s ease infinite">

    <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-80 w-80 rounded-full opacity-25 blur-3xl" style="background:var(--sea)"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -right-16 h-96 w-96 rounded-full opacity-20 blur-3xl" style="background:var(--amber)"></div>

    <!-- Vague de quai — clin d'oeil maritime discret en pied de page -->
    <svg aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 w-full opacity-40" viewBox="0 0 1200 80" preserveAspectRatio="none" style="height:70px">
        <path d="M0,40 C150,70 350,10 600,40 C850,70 1050,10 1200,40 L1200,80 L0,80 Z" fill="var(--card)" />
    </svg>

    <div class="relative w-full max-w-sm rounded-2xl p-8" style="background:var(--card); box-shadow: var(--shadow-soft-lg)">
        <div class="mb-7 flex items-center gap-3">
            <div class="animate-floaty grid h-12 w-12 flex-none place-items-center rounded-xl shadow-soft" style="background:linear-gradient(135deg, var(--amber), var(--amber-soft))">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#04262a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 17l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1" />
                    <path d="M5 17V9l7-4 7 4v8" />
                    <path d="M12 5v12" />
                </svg>
            </div>
            <div>
                <h1 class="text-lg font-bold leading-tight" style="color:var(--ink)">EscaleReport</h1>
                <p class="text-[11px] font-medium uppercase tracking-wide" style="color:var(--text-soft)">Côte d'Ivoire Terminal</p>
            </div>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
            <input type="hidden" asp-for="ReturnUrl" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert-error"></div>
            }

            <div>
                <label asp-for="UserName" class="field-label"></label>
                <input asp-for="UserName" autofocus class="input-field" />
            </div>
            <div>
                <label asp-for="Password" class="field-label"></label>
                <input asp-for="Password" class="input-field" />
            </div>

            <button type="submit" class="btn-primary w-full">
                Se connecter
            </button>
        </form>
    </div>

    <style>
        @@keyframes hdrShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
    </style>
</body>
</html>
