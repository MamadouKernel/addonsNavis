@using EscaleReport.Web.Domain.Identity
@using EscaleReport.Web.Models
@model UsersIndexViewModel
@{
    ViewData["Title"] = "Comptes & permissions";
    var permissionLabels = new Dictionary<string, string>
    {
        [Permissions.CreerEscale] = "Créer une escale",
        [Permissions.ModifierEscale] = "Modifier une escale",
        [Permissions.SupprimerEscale] = "Supprimer une escale",
        [Permissions.MarquerEscaleTerminee] = "Marquer une escale terminée",
        [Permissions.ConsulterEscales] = "Consulter les escales",
        [Permissions.SaisirDonneesModule] = "Saisir les données de son module",
        [Permissions.ModifierDonneesModule] = "Modifier les données de son module",
        [Permissions.ConsulterAutresModules] = "Consulter les autres modules",
        [Permissions.GenererPdf] = "Générer un PDF",
        [Permissions.GenererExcel] = "Générer un Excel",
        [Permissions.EnvoyerRapportEmail] = "Envoyer un rapport par e-mail",
        [Permissions.ConsulterRapportGeneral] = "Consulter le rapport général",
        [Permissions.ValiderRapport] = "Valider un rapport",
        [Permissions.AdministrerUtilisateurs] = "Administrer les utilisateurs",
        [Permissions.ConsulterJournalAudit] = "Consulter le journal d'audit",
        [Permissions.ModifierParametres] = "Modifier les paramètres",
        [Permissions.ExporterDonnees] = "Exporter les données",
        [Permissions.ConsulterStatistiques] = "Consulter les statistiques"
    };
}

<div class="mb-8">
    <h1 class="page-title">Comptes &amp; permissions</h1>
    <p class="page-subtitle">Gestion des utilisateurs, rôles et permissions décorrélées du rôle — CDC §2</p>
</div>

@if (TempData["Error"] is string error)
{
    <div class="mb-6 alert-error">@error</div>
}

<section class="card mb-6">
    <h2 class="card-title mb-4">Créer un compte</h2>
    <form asp-controller="Users" asp-action="Create" method="post" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div><label class="field-label">Identifiant</label><input name="UserName" required class="input-field" /></div>
        <div><label class="field-label">Mot de passe</label><input type="password" name="Password" required class="input-field" /></div>
        <div>
            <label class="field-label">Rôle</label>
            <select name="Role" required class="input-field">
                @foreach (var r in Model.Roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label">Poste (si Dispatcher)</label>
            <select name="PosteParDefaut" class="input-field">
                <option value="">—</option>
                @foreach (var p in Model.DispatchPosts)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <div><label class="field-label">Équipe</label><input name="Equipe" class="input-field" /></div>
        <div class="sm:col-span-2 lg:col-span-5">
            <button type="submit" class="btn-primary">Créer le compte</button>
        </div>
    </form>
</section>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
@foreach (var u in Model.Users)
{
    var isAdmin = u.Role == Roles.Administrateur;
    <section class="card">
        <div class="mb-3 flex items-start justify-between gap-2">
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-slate-900">@u.UserName</span>
                    @if (!u.IsActive)
                    {
                        <span class="badge-neutral opacity-60">désactivé</span>
                    }
                    @if (u.IsLockedOut)
                    {
                        <span class="badge-neutral" style="color:#b91c1c">verrouillé</span>
                    }
                </div>
                <div class="text-xs text-slate-500">@u.Email</div>
            </div>
            <a asp-controller="Audit" asp-action="Index" asp-route-userName="@u.UserName" class="btn-link text-xs whitespace-nowrap">Historique</a>
        </div>

        <div class="mb-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <form asp-controller="Users" asp-action="ChangeRole" method="post">
                <input type="hidden" name="id" value="@u.Id" />
                <label class="field-label">Rôle</label>
                <select name="role" class="input-field" onchange="this.form.submit()">
                    @foreach (var r in Model.Roles)
                    {
                        <option value="@r" selected="@(r == u.Role)">@r</option>
                    }
                </select>
            </form>
            <form asp-controller="Users" asp-action="UpdateProfile" method="post" class="flex gap-2 items-end">
                <input type="hidden" name="id" value="@u.Id" />
                <div class="flex-1">
                    <label class="field-label">Poste</label>
                    <select name="posteParDefaut" class="input-field">
                        <option value="">—</option>
                        @foreach (var p in Model.DispatchPosts)
                        {
                            <option value="@p" selected="@(p == u.PosteParDefaut)">@p</option>
                        }
                    </select>
                </div>
                <div class="flex-1">
                    <label class="field-label">Équipe</label>
                    <input name="equipe" value="@u.Equipe" class="input-field" />
                </div>
                <button type="submit" class="btn-secondary text-xs whitespace-nowrap">OK</button>
            </form>
        </div>

        <div class="mb-3 flex flex-wrap gap-2">
            <form asp-controller="Users" asp-action="ToggleActive" method="post">
                <input type="hidden" name="id" value="@u.Id" />
                <button type="submit" class="btn-secondary text-xs">@(u.IsActive ? "Désactiver" : "Activer")</button>
            </form>
            <form asp-controller="Users" asp-action="ResetPassword" method="post" class="flex gap-1">
                <input type="hidden" name="id" value="@u.Id" />
                <input type="password" name="newPassword" placeholder="Nouveau mot de passe" required minlength="6" class="input-field text-xs" style="width:170px" />
                <button type="submit" class="btn-secondary text-xs whitespace-nowrap">Réinitialiser</button>
            </form>
        </div>

        @if (isAdmin)
        {
            <div class="text-xs italic text-slate-400">Rôle Administrateur : toutes les permissions sont accordées automatiquement.</div>
        }
        else
        {
            <div class="flex flex-wrap gap-1.5">
                @foreach (var perm in Permissions.All)
                {
                    var granted = u.Permissions.Contains(perm);
                    <form asp-controller="Users" asp-action="TogglePermission" method="post" class="inline-flex">
                        <input type="hidden" name="id" value="@u.Id" />
                        <input type="hidden" name="permissionKey" value="@perm" />
                        <button type="submit" class="@(granted ? "badge-brand" : "badge-neutral opacity-50") cursor-pointer" title="@permissionLabels[perm]">
                            @permissionLabels[perm]
                        </button>
                    </form>
                }
            </div>
        }
    </section>
}
</div>
