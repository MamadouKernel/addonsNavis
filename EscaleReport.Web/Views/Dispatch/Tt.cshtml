@using EscaleReport.Web.Application.Dispatch.Queries.GetDispatchTt
@model DispatchTtDto
@{
    ViewData["Title"] = "Dispatch TT";
}

<div class="mb-8">
    <h1 class="page-title">Dispatch TT</h1>
    <p class="page-subtitle">Effectif des Terminal Tractors et affectation par navire — CDC §7</p>
</div>


<section class="card mb-8">
    <h2 class="card-title mb-5">Effectif du parc</h2>

    <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Non désignés</div>
            <div class="mt-1 font-mono text-2xl font-bold text-slate-900">@Model.Effectif.NonDesignes</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Disponibles</div>
            <div class="mt-1 font-mono text-2xl font-bold text-emerald-600">@Model.Effectif.Disponibles</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Désignés</div>
            <div class="mt-1 font-mono text-2xl font-bold text-slate-900">@Model.Effectif.Designes</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Retirés</div>
            <div class="mt-1 font-mono text-2xl font-bold text-rose-600">@Model.Effectif.Retires</div>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="UpdateTtEffectif" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div>
            <label class="field-label">Total parc</label>
            <input name="TotalParc" type="number" min="0" value="@Model.Effectif.TotalParc" class="input-field" />
        </div>
        <div>
            <label class="field-label">Désignés</label>
            <input name="Designes" type="number" min="0" value="@Model.Effectif.Designes" class="input-field" />
        </div>
        <div>
            <label class="field-label">Raison non-désignation</label>
            <input name="RaisonNonDesignation" value="@Model.Effectif.RaisonNonDesignation" class="input-field" />
        </div>
        <div>
            <label class="field-label">Retirés (pannes...)</label>
            <input name="Retires" type="number" min="0" value="@Model.Effectif.Retires" class="input-field" />
        </div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">Mettre à jour</button>
        </div>
    </form>
</section>

<section class="card">
    <h2 class="card-title mb-1">Affectation par navire</h2>
    <p class="card-subtitle mb-5">Les écarts entre besoin et affectation réelle sont signalés automatiquement.</p>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Navire</th>
                        <th>Prévu</th>
                        <th>Affecté</th>
                        <th class="hidden md:table-cell">Opérationnel</th>
                        <th>Écart</th>
                        <th class="hidden lg:table-cell">Observations</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Assignments.Any())
                {
                    <tr><td colspan="6" class="!text-center text-slate-400 py-8">Aucune affectation.</td></tr>
                }
                @foreach (var a in Model.Assignments)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@a.Navire</td>
                        <td>@a.NombrePrevu</td>
                        <td>@a.NombreAffecte</td>
                        <td class="hidden md:table-cell">@a.NombreOperationnel</td>
                        <td>
                            @if (a.Ecart < 0)
                            {
                                <span class="badge-danger">@a.Ecart</span>
                            }
                            else if (a.Ecart > 0)
                            {
                                <span class="badge-info">+@a.Ecart</span>
                            }
                            else
                            {
                                <span class="badge-success">0</span>
                            }
                        </td>
                        <td class="hidden lg:table-cell">@a.Observations</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="AssignTt" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div>
            <label class="field-label">Navire</label>
            <select name="EscaleId" class="input-field">
                @foreach (var e in Model.EscalesDisponibles)
                {
                    <option value="@e.Id">@e.Navire</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label">Prévu</label>
            <input name="NombrePrevu" type="number" min="0" value="0" class="input-field" />
        </div>
        <div>
            <label class="field-label">Affecté</label>
            <input name="NombreAffecte" type="number" min="0" value="0" class="input-field" />
        </div>
        <div>
            <label class="field-label">Opérationnel</label>
            <input name="NombreOperationnel" type="number" min="0" value="0" class="input-field" />
        </div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Affecter
            </button>
        </div>
        <div class="sm:col-span-2 lg:col-span-5">
            <label class="field-label">Observations</label>
            <input name="Observations" class="input-field" />
        </div>
    </form>
</section>

<section class="card mt-8">
    <h2 class="card-title mb-1">Déconnexions TT</h2>
    <p class="card-subtitle mb-5">CDC §7.3</p>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>N° TT</th>
                        <th>Début</th>
                        <th class="hidden md:table-cell">Retour</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th class="hidden md:table-cell">Raison</th>
                        <th>Retrait effectif</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Deconnexions.Any())
                {
                    <tr><td colspan="8" class="!text-center text-slate-400 py-8">Aucune déconnexion signalée.</td></tr>
                }
                @foreach (var d in Model.Deconnexions)
                {
                    <tr>
                        <td class="font-mono font-semibold text-slate-900">@d.NumeroTt</td>
                        <td class="whitespace-nowrap">@d.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden whitespace-nowrap md:table-cell">@(d.DateRetourUtc?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td class="hidden lg:table-cell">@(d.Duree.HasValue ? $"{(int)d.Duree.Value.TotalHours}h{Math.Abs(d.Duree.Value.Minutes):D2}" : "—")</td>
                        <td class="hidden md:table-cell">@d.Raison</td>
                        <td>@(d.RetireEffectif ? "Oui" : "Non")</td>
                        <td>
                            @if (d.EstResolue) { <span class="badge-success">Rétabli</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (!d.EstResolue)
                            {
                                <form asp-controller="Dispatch" asp-action="CloseTtDeconnexion" method="post">
                                    <input type="hidden" name="deconnexionId" value="@d.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Signaler le retour</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="AddTtDeconnexion" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div><label class="field-label">N° TT</label><input name="NumeroTt" required class="input-field" /></div>
        <div><label class="field-label">Début</label><input type="datetime-local" name="DateDebutUtc" class="input-field" /></div>
        <div class="sm:col-span-2"><label class="field-label">Raison</label><input name="Raison" class="input-field" /></div>
        <div class="flex items-end gap-3">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                <input type="checkbox" name="RetireEffectif" value="true" class="h-4 w-4 accent-indigo-600" />
                Retrait effectif
            </label>
        </div>
        <div class="flex items-end lg:col-span-5">
            <button type="submit" class="btn-primary">Déclarer</button>
        </div>
    </form>
</section>
