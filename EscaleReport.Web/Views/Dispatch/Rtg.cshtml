@using EscaleReport.Web.Application.Dispatch.Queries.GetDispatchRtg
@using EscaleReport.Web.Domain.Dispatch
@model DispatchRtgDto
@{
    ViewData["Title"] = "Dispatch RTG";

    static string DureeLabel(TimeSpan? d) => d.HasValue ? $"{(int)d.Value.TotalHours}h{Math.Abs(d.Value.Minutes):D2}" : "—";

    var pannesEnCours = Model.Pannes.Count(p => !p.EstResolue);
    var clashsEnCours = Model.Clashes.Count(c => !c.EstResolu);
    var gateEnCours = Model.GateTruckIssues.Count(g => !g.EstResolu);
    var incidentsStsEnCours = Model.StsIncidents.Count(i => !i.EstResolu);
}

<div class="mb-8">
    <h1 class="page-title">Dispatch RTG</h1>
    <p class="page-subtitle">Effectif, pannes, clashs et camions Gate — CDC §8</p>
</div>


<div class="mb-6 flex gap-2 overflow-x-auto pb-1" id="rtgTabs">
    <button type="button" class="tab-btn active" data-tab="effectif">Effectif</button>
    <button type="button" class="tab-btn" data-tab="pannes">Pannes <span class="tab-count">@pannesEnCours</span></button>
    <button type="button" class="tab-btn" data-tab="clashs">Clashs <span class="tab-count">@clashsEnCours</span></button>
    <button type="button" class="tab-btn" data-tab="gate">Camions Gate <span class="tab-count">@gateEnCours</span></button>
    <button type="button" class="tab-btn" data-tab="stsIncidents">Incidents STS <span class="tab-count">@incidentsStsEnCours</span></button>
</div>

<!-- ============ EFFECTIF (§8.1) ============ -->
<section id="tab-effectif" class="rtg-panel card">
    <h2 class="card-title mb-5">Effectif du parc RTG</h2>

    <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-5">
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Total parc</div>
            <div class="mt-1 font-mono text-2xl font-bold text-slate-900">@Model.Effectif.TotalParc</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Disponible</div>
            <div class="mt-1 font-mono text-2xl font-bold text-emerald-600">@Model.Effectif.Disponible</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Affecté</div>
            <div class="mt-1 font-mono text-2xl font-bold text-slate-900">@Model.Effectif.Affecte</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">En panne</div>
            <div class="mt-1 font-mono text-2xl font-bold text-rose-600">@Model.Effectif.EnPanne</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Retiré</div>
            <div class="mt-1 font-mono text-2xl font-bold text-slate-500">@Model.Effectif.Retire</div>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="UpdateRtgEffectif" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-6">
        <div><label class="field-label">Total parc</label><input name="TotalParc" type="number" min="0" value="@Model.Effectif.TotalParc" class="input-field" /></div>
        <div><label class="field-label">Disponible</label><input name="Disponible" type="number" min="0" value="@Model.Effectif.Disponible" class="input-field" /></div>
        <div><label class="field-label">Affecté</label><input name="Affecte" type="number" min="0" value="@Model.Effectif.Affecte" class="input-field" /></div>
        <div><label class="field-label">En panne</label><input name="EnPanne" type="number" min="0" value="@Model.Effectif.EnPanne" class="input-field" /></div>
        <div><label class="field-label">Retiré</label><input name="Retire" type="number" min="0" value="@Model.Effectif.Retire" class="input-field" /></div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">Mettre à jour</button>
        </div>
    </form>
</section>

<!-- ============ PANNES RTG (§8.3) ============ -->
<section id="tab-pannes" class="rtg-panel card hidden">
    <h2 class="card-title mb-1">Pannes RTG</h2>
    <p class="card-subtitle mb-5">CDC §8.3</p>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Engin</th>
                        <th>Début</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th class="hidden md:table-cell">Raison</th>
                        <th>Retrait effectif</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Pannes.Any())
                {
                    <tr><td colspan="7" class="!text-center text-slate-400 py-8">Aucune panne RTG.</td></tr>
                }
                @foreach (var p in Model.Pannes)
                {
                    <tr>
                        <td class="font-mono font-semibold text-slate-900">@p.Engin</td>
                        <td class="whitespace-nowrap">@p.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden lg:table-cell">@DureeLabel(p.Duree)</td>
                        <td class="hidden md:table-cell">@p.Raison</td>
                        <td>@(p.RetireEffectif ? "Oui" : "Non")</td>
                        <td>
                            @if (p.EstResolue) { <span class="badge-success">Reprise</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (!p.EstResolue)
                            {
                                <form asp-controller="Dispatch" asp-action="CloseRtgPanne" method="post">
                                    <input type="hidden" name="panneId" value="@p.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Clôturer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="AddRtgPanne" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div><label class="field-label">Engin</label><input name="Engin" required placeholder="RTG-03" class="input-field" /></div>
        <div><label class="field-label">Début</label><input type="datetime-local" name="DateDebutUtc" class="input-field" /></div>
        <div class="sm:col-span-2"><label class="field-label">Raison</label><input name="Raison" class="input-field" /></div>
        <div class="flex items-end gap-3">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                <input type="checkbox" name="RetireEffectif" value="true" class="h-4 w-4" style="accent-color:var(--sea)" />
                Retrait effectif
            </label>
        </div>
        <div class="flex items-end lg:col-span-5">
            <button type="submit" class="btn-primary">Déclarer</button>
        </div>
    </form>
</section>

<!-- ============ CLASHS (§8.4) ============ -->
<section id="tab-clashs" class="rtg-panel card hidden">
    <h2 class="card-title mb-1">Clashs (conflits d'utilisation d'engins)</h2>
    <p class="card-subtitle mb-5">CDC §8.4</p>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Lieu</th>
                        <th class="hidden md:table-cell">Engins concernés</th>
                        <th>Début</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th>Description</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Clashes.Any())
                {
                    <tr><td colspan="7" class="!text-center text-slate-400 py-8">Aucun clash enregistré.</td></tr>
                }
                @foreach (var c in Model.Clashes)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@c.Lieu</td>
                        <td class="hidden md:table-cell">@c.EnginsConcernes</td>
                        <td class="whitespace-nowrap">@c.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden lg:table-cell">@DureeLabel(c.Duree)</td>
                        <td>@c.Description</td>
                        <td>
                            @if (c.EstResolu) { <span class="badge-success">Résolu</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (!c.EstResolu)
                            {
                                <form asp-controller="Dispatch" asp-action="CloseRtgClash" method="post">
                                    <input type="hidden" name="clashId" value="@c.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Clôturer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="AddRtgClash" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div><label class="field-label">Lieu</label><input name="Lieu" required class="input-field" /></div>
        <div><label class="field-label">Engins concernés</label><input name="EnginsConcernes" required class="input-field" /></div>
        <div><label class="field-label">Début</label><input type="datetime-local" name="DateDebutUtc" class="input-field" /></div>
        <div class="sm:col-span-2 lg:col-span-2"><label class="field-label">Description</label><input name="Description" required class="input-field" /></div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">Déclarer</button>
        </div>
    </form>
</section>

<!-- ============ PROBLEMES CAMIONS GATE (§8.5) ============ -->
<section id="tab-gate" class="rtg-panel card hidden">
    <h2 class="card-title mb-1">Problèmes des camions Gate</h2>
    <p class="card-subtitle mb-5">CDC §8.5</p>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Camion / référence</th>
                        <th>Début</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th class="hidden md:table-cell">Problème</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.GateTruckIssues.Any())
                {
                    <tr><td colspan="7" class="!text-center text-slate-400 py-8">Aucun problème signalé.</td></tr>
                }
                @foreach (var g in Model.GateTruckIssues)
                {
                    <tr>
                        <td>
                            @if (g.TypeOperation == GateOperationType.Livraison) { <span class="badge-info">Livraison</span> }
                            else { <span class="badge-brand">Réception</span> }
                        </td>
                        <td class="font-mono font-semibold text-slate-900">@g.CamionReference</td>
                        <td class="whitespace-nowrap">@g.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden lg:table-cell">@DureeLabel(g.Duree)</td>
                        <td class="hidden md:table-cell">@g.ProblemeRencontre</td>
                        <td>
                            @if (g.EstResolu) { <span class="badge-success">Résolu</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (!g.EstResolu)
                            {
                                <form asp-controller="Dispatch" asp-action="CloseGateTruckIssue" method="post">
                                    <input type="hidden" name="issueId" value="@g.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Clôturer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="Dispatch" asp-action="AddGateTruckIssue" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div>
            <label class="field-label">Type d'opération</label>
            <select name="TypeOperation" class="input-field">
                <option value="@((int)GateOperationType.Livraison)">Livraison</option>
                <option value="@((int)GateOperationType.Reception)">Réception</option>
            </select>
        </div>
        <div><label class="field-label">Camion / référence</label><input name="CamionReference" required class="input-field" /></div>
        <div><label class="field-label">Début</label><input type="datetime-local" name="DateDebutUtc" class="input-field" /></div>
        <div class="sm:col-span-2"><label class="field-label">Problème rencontré</label><input name="ProblemeRencontre" required class="input-field" /></div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">Déclarer</button>
        </div>
    </form>
</section>

<!-- ============ INCIDENTS STS EN LECTURE SEULE (§8.2) ============ -->
<section id="tab-stsIncidents" class="rtg-panel card hidden">
    <h2 class="card-title mb-1">Incidents STS du shift</h2>
    <p class="card-subtitle mb-5">CDC §8.2 — consultation en lecture seule ; la saisie relève du poste Dispatch STS.</p>

    <div class="table-shell">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Navire</th>
                        <th class="hidden md:table-cell">Portique</th>
                        <th>Type</th>
                        <th>Début</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.StsIncidents.Any())
                {
                    <tr><td colspan="6" class="!text-center text-slate-400 py-8">Aucun incident STS.</td></tr>
                }
                @foreach (var i in Model.StsIncidents)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@i.Navire</td>
                        <td class="hidden md:table-cell font-mono">@(i.GantryCode ?? "—")</td>
                        <td>@i.TypeIncident</td>
                        <td class="whitespace-nowrap">@i.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden lg:table-cell">@DureeLabel(i.Duree)</td>
                        <td>
                            @if (i.EstResolu) { <span class="badge-success">Repris</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll('#rtgTabs .tab-btn');
            tabs.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    tabs.forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    document.querySelectorAll('.rtg-panel').forEach(function (p) { p.classList.add('hidden'); });
                    var panel = document.getElementById('tab-' + btn.dataset.tab);
                    if (panel) { panel.classList.remove('hidden'); }
                });
            });
        })();
    </script>
}
