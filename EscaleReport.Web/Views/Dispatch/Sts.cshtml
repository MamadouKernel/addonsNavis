@using EscaleReport.Web.Application.Common.Models
@using EscaleReport.Web.Application.Dispatch.Queries.GetDispatchSts
@using EscaleReport.Web.Domain.Dispatch
@model DispatchStsDto
@{
    ViewData["Title"] = "Dispatch STS";

    static string StatusBadgeClass(GantryStatus s) => s switch
    {
        GantryStatus.Disponible => "badge-success",
        GantryStatus.Affecte => "badge-warning",
        GantryStatus.EnPanne => "badge-danger",
        GantryStatus.EnMaintenance => "badge-brand",
        _ => "badge-neutral"
    };

    static string StatusLabel(GantryStatus s) => s switch
    {
        GantryStatus.Disponible => "Disponible",
        GantryStatus.Affecte => "Affecté",
        GantryStatus.EnPanne => "En panne",
        GantryStatus.EnMaintenance => "En maintenance",
        _ => "Indisponible"
    };

    var incidentsEnCours = Model.IncidentsEnCoursCount;
    var pointeursActifs = Model.PointeursActifsCount;
    var ropnEnCours = Model.RopnEnCoursCount;
}

<div class="mb-8">
    <h1 class="page-title">Dispatch STS</h1>
    <p class="page-subtitle">Portiques, incidents, pointeurs et ROPN</p>
</div>


<!-- ============ SELECTION DU SHIFT (§6.1) ============ -->
<section class="card mb-6">
    <h2 class="card-title mb-1">Sélection du shift</h2>
    <p class="card-subtitle mb-4">Navires affichés automatiquement : en cours d'opération, ou attendus (ETA) pendant la date/shift sélectionnés.</p>

    <form asp-controller="Dispatch" asp-action="Sts" method="get" class="mb-5 flex flex-wrap items-end gap-4">
        <div>
            <label class="field-label">Date</label>
            <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="input-field" />
        </div>
        <div>
            <label class="field-label">Shift</label>
            <select name="shift" class="input-field">
                <option value="">Tous</option>
                @foreach (var s in Model.ShiftsDisponibles)
                {
                    @if (s == Model.SelectedShift)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="btn-primary">Filtrer</button>
    </form>

    <div class="table-shell">
        <div class="table-scroll">
            <table class="table-modern" data-client-pagination data-page-size="10">
                <thead>
                    <tr>
                        <th>Navire</th>
                        <th class="hidden md:table-cell">Voyage</th>
                        <th>ETA</th>
                        <th class="hidden md:table-cell">Shift</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.NaviresDuShift.Any())
                {
                    <tr><td colspan="5" class="!text-center text-slate-400 py-8">Aucun navire en cours ou attendu pour cette sélection.</td></tr>
                }
                @foreach (var n in Model.NaviresDuShift)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@n.Navire</td>
                        <td class="hidden md:table-cell">@n.Voyage</td>
                        <td class="whitespace-nowrap">@n.Eta.ToString("dd/MM HH:mm")</td>
                        <td class="hidden md:table-cell">@(n.Shift ?? "—")</td>
                        <td>
                            @if (n.EnCours) { <span class="badge-warning">En cours</span> }
                            else { <span class="badge-neutral">Attendu</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="mb-6 flex gap-2 overflow-x-auto pb-1" id="stsTabs">
    <button type="button" class="tab-btn active" data-tab="portiques">Portiques</button>
    <button type="button" class="tab-btn" data-tab="incidents">Incidents <span class="tab-count">@incidentsEnCours</span></button>
    <button type="button" class="tab-btn" data-tab="pointeurs">Pointeurs <span class="tab-count">@pointeursActifs</span></button>
    <button type="button" class="tab-btn" data-tab="ropn">ROPN <span class="tab-count">@ropnEnCours</span></button>
</div>

<!-- ============ PORTIQUES + AFFECTATIONS (§6.2) ============ -->
<section id="tab-portiques" class="sts-panel">
    <section class="card mb-8">
        <h2 class="card-title mb-5">Portiques</h2>
        <div class="flex flex-wrap gap-4">
        @foreach (var g in Model.Gantries)
        {
            <div class="flex min-w-[150px] flex-col items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/50 p-4">
                <span class="text-xl font-extrabold text-slate-900">@g.Code</span>
                <span class="@StatusBadgeClass(g.Statut)">@StatusLabel(g.Statut)</span>
                <form asp-controller="Dispatch" asp-action="ChangeGantryStatus" method="post" class="w-full">
                    <input type="hidden" name="GantryId" value="@g.Id" />
                    <select name="Statut" class="js-auto-submit input-field py-1.5 text-xs">
                        @foreach (GantryStatus s in Enum.GetValues<GantryStatus>())
                        {
                            @if (s == g.Statut)
                            {
                                <option value="@((int)s)" selected>@StatusLabel(s)</option>
                            }
                            else
                            {
                                <option value="@((int)s)">@StatusLabel(s)</option>
                            }
                        }
                    </select>
                </form>
            </div>
        }
        </div>
    </section>

    <section class="card">
        <h2 class="card-title mb-5">Affectations</h2>

        <div class="table-shell mb-6">
            <div class="table-scroll">
                <table class="table-modern">
                    <thead>
                        <tr>
                            <th>Portique</th>
                            <th>Navire</th>
                            <th>Début</th>
                            <th class="hidden md:table-cell">Fin</th>
                            <th class="hidden lg:table-cell">Tâche / zone</th>
                            <th>Statut</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Assignments.Items.Any())
                    {
                        <tr><td colspan="7" class="!text-center text-slate-400 py-8">Aucune affectation.</td></tr>
                    }
                    @foreach (var a in Model.Assignments.Items)
                    {
                        <tr>
                            <td class="font-mono font-semibold text-slate-900">@a.GantryCode</td>
                            <td>@a.Navire</td>
                            <td class="whitespace-nowrap">@a.HeureDebut.ToString("dd/MM HH:mm")</td>
                            <td class="hidden whitespace-nowrap md:table-cell">@(a.HeureFin?.ToString("dd/MM HH:mm") ?? "—")</td>
                            <td class="hidden lg:table-cell">@a.TacheOuZone</td>
                            <td>
                                @if (a.Statut == AssignmentStatus.EnCours)
                                {
                                    <span class="badge-warning">En cours</span>
                                }
                                else
                                {
                                    <span class="badge-neutral">Terminée</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (a.Statut == AssignmentStatus.EnCours)
                                {
                                    <form asp-controller="Dispatch" asp-action="EndAssignment" method="post">
                                        <input type="hidden" name="assignmentId" value="@a.Id" />
                                        <button type="submit" class="btn-link whitespace-nowrap">Terminer</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", PaginationViewModel.For(Model.Assignments, "assignmentsPage"))

        <form asp-controller="Dispatch" asp-action="AssignGantry" method="post"
              class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <label class="field-label">Portique</label>
                <select name="GantryId" class="input-field">
                    @foreach (var g in Model.Gantries)
                    {
                        <option value="@g.Id">@g.Code (@StatusLabel(g.Statut))</option>
                    }
                </select>
            </div>
            <div>
                <label class="field-label">Navire</label>
                <select name="EscaleId" class="input-field">
                    @foreach (var e in Model.EscalesDisponibles)
                    {
                        <option value="@e.Id">@e.Navire</option>
                    }
                </select>
            </div>
            <div>
                <label class="field-label">Heure de début</label>
                <input type="datetime-local" name="HeureDebut" class="input-field" />
            </div>
            <div>
                <label class="field-label">Tâche / zone</label>
                <input name="TacheOuZone" class="input-field" />
            </div>
            <div class="flex items-end">
                <button type="submit" class="btn-primary w-full">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Affecter
                </button>
            </div>
        </form>
    </section>
</section>

<!-- ============ INCIDENTS STS (§6.3) ============ -->
<section id="tab-incidents" class="sts-panel card hidden">
    <h2 class="card-title mb-1">Incidents STS</h2>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Navire</th>
                        <th class="hidden md:table-cell">Portique</th>
                        <th>Type</th>
                        <th>Début</th>
                        <th class="hidden lg:table-cell">Durée</th>
                        <th>Retrait effectif</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Incidents.Items.Any())
                {
                    <tr><td colspan="8" class="!text-center text-slate-400 py-8">Aucun incident STS.</td></tr>
                }
                @foreach (var i in Model.Incidents.Items)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@i.Navire</td>
                        <td class="hidden md:table-cell font-mono">@(i.GantryCode ?? "—")</td>
                        <td>@i.TypeIncident</td>
                        <td class="whitespace-nowrap">@i.DateDebutUtc.ToString("dd/MM HH:mm")</td>
                        <td class="hidden lg:table-cell">@(i.Duree.HasValue ? $"{(int)i.Duree.Value.TotalHours}h{Math.Abs(i.Duree.Value.Minutes):D2}" : "—")</td>
                        <td>@(i.RetirePortiqueEffectif ? "Oui" : "Non")</td>
                        <td>
                            @if (i.EstResolu) { <span class="badge-success">Repris</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (!i.EstResolu)
                            {
                                <form asp-controller="Dispatch" asp-action="CloseStsIncident" method="post">
                                    <input type="hidden" name="incidentId" value="@i.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Clôturer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination", PaginationViewModel.For(Model.Incidents, "incidentsPage"))

    <form asp-controller="Dispatch" asp-action="AddStsIncident" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-5">
        <div>
            <label class="field-label">Navire</label>
            <select name="EscaleId" class="input-field">
                @foreach (var e in Model.EscalesDisponibles)
                {
                    <option value="@e.Id">@e.Navire</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label">Portique</label>
            <select name="GantryId" class="input-field">
                <option value="">—</option>
                @foreach (var g in Model.Gantries)
                {
                    <option value="@g.Id">@g.Code</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label">Type d'incident</label>
            <select name="TypeIncident" class="input-field">
                @foreach (var t in Model.TypesIncidentDisponibles)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label">Début</label>
            <input type="datetime-local" name="DateDebutUtc" class="input-field" />
        </div>
        <div class="flex items-end gap-3">
            <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
                <input type="checkbox" name="RetirePortiqueEffectif" value="true" class="h-4 w-4" style="accent-color:var(--sea)" />
                Retrait effectif
            </label>
        </div>
        <div class="sm:col-span-2 lg:col-span-4">
            <label class="field-label">Cause</label>
            <input name="Cause" class="input-field" />
        </div>
        <div class="flex items-end">
            <button type="submit" class="btn-primary w-full">Déclarer</button>
        </div>
    </form>
</section>

<!-- ============ POINTEURS (§6.4) ============ -->
<section id="tab-pointeurs" class="sts-panel card hidden">
    <h2 class="card-title mb-1">Pointeurs</h2>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th class="hidden md:table-cell">Rôle</th>
                        <th class="hidden md:table-cell">Navire / zone</th>
                        <th>Prise de poste</th>
                        <th>Fin</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Pointeurs.Items.Any())
                {
                    <tr><td colspan="6" class="!text-center text-slate-400 py-8">Aucun pointeur affecté.</td></tr>
                }
                @foreach (var p in Model.Pointeurs.Items)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@p.Nom</td>
                        <td class="hidden md:table-cell">@p.Role</td>
                        <td class="hidden md:table-cell">@p.NavireOuZone</td>
                        <td class="whitespace-nowrap">@p.HeurePriseDePosteUtc.ToString("dd/MM HH:mm")</td>
                        <td class="whitespace-nowrap">@(p.HeureFinUtc?.ToString("dd/MM HH:mm") ?? "—")</td>
                        <td class="text-right">
                            @if (!p.HeureFinUtc.HasValue)
                            {
                                <form asp-controller="Dispatch" asp-action="EndStsPointeur" method="post">
                                    <input type="hidden" name="pointeurId" value="@p.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Terminer</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination", PaginationViewModel.For(Model.Pointeurs, "pointeursPage"))

    <form asp-controller="Dispatch" asp-action="AddStsPointeur" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-4">
        <div><label class="field-label">Nom</label><input name="Nom" required class="input-field" /></div>
        <div><label class="field-label">Rôle</label><input name="Role" class="input-field" /></div>
        <div><label class="field-label">Navire / zone</label><input name="NavireOuZone" class="input-field" /></div>
        <div><label class="field-label">Prise de poste</label><input type="datetime-local" name="HeurePriseDePosteUtc" class="input-field" /></div>
        <div class="flex items-end lg:col-span-4">
            <button type="submit" class="btn-primary">Ajouter</button>
        </div>
    </form>
</section>

<!-- ============ ROPN (§6.5) ============ -->
<section id="tab-ropn" class="sts-panel card hidden">
    <h2 class="card-title mb-1">Suivi du ROPN</h2>

    <div class="table-shell mb-6">
        <div class="table-scroll">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th class="hidden md:table-cell">Rôle</th>
                        <th>Difficulté</th>
                        <th class="hidden lg:table-cell">Action réalisée</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.RopnEntries.Items.Any())
                {
                    <tr><td colspan="6" class="!text-center text-slate-400 py-8">Aucune observation ROPN.</td></tr>
                }
                @foreach (var r in Model.RopnEntries.Items)
                {
                    <tr>
                        <td class="font-semibold text-slate-900">@r.Nom</td>
                        <td class="hidden md:table-cell">@r.Role</td>
                        <td>@r.DifficulteRencontree</td>
                        <td class="hidden lg:table-cell">@r.ActionRealisee</td>
                        <td>
                            @if (r.Statut == RopnStatus.Resolu) { <span class="badge-success">Résolu</span> }
                            else { <span class="badge-warning">En cours</span> }
                        </td>
                        <td class="text-right">
                            @if (r.Statut == RopnStatus.EnCours)
                            {
                                <form asp-controller="Dispatch" asp-action="ResolveRopnEntry" method="post">
                                    <input type="hidden" name="ropnEntryId" value="@r.Id" />
                                    <button type="submit" class="btn-link whitespace-nowrap">Résoudre</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination", PaginationViewModel.For(Model.RopnEntries, "ropnPage"))

    <form asp-controller="Dispatch" asp-action="AddRopnEntry" method="post"
          class="grid grid-cols-1 gap-4 rounded-xl border border-slate-200 bg-slate-50/60 p-5 sm:grid-cols-2 lg:grid-cols-4">
        <div><label class="field-label">Nom</label><input name="Nom" required class="input-field" /></div>
        <div><label class="field-label">Rôle</label><input name="Role" class="input-field" /></div>
        <div class="sm:col-span-2 lg:col-span-2"><label class="field-label">Difficulté rencontrée</label><input name="DifficulteRencontree" required class="input-field" /></div>
        <div class="flex items-end lg:col-span-4">
            <button type="submit" class="btn-primary">Ajouter</button>
        </div>
    </form>
</section>

@section Scripts {
    <script nonce="@Context.GetOrCreateCspNonce()">
        (function () {
            var tabs = document.querySelectorAll('#stsTabs .tab-btn');
            tabs.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    tabs.forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    document.querySelectorAll('.sts-panel').forEach(function (p) { p.classList.add('hidden'); });
                    var panel = document.getElementById('tab-' + btn.dataset.tab);
                    if (panel) { panel.classList.remove('hidden'); }
                });
            });
        })();
    </script>
}
