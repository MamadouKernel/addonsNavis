@using EscaleReport.Web.Application.Statistics.Queries.GetIndicators
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Rendering
@model IndicatorsResultDto
@{
    ViewData["Title"] = "Reporting et indicateurs";
    var dateDebut = Context.Request.Query["dateDebut"].ToString();
    var dateFin = Context.Request.Query["dateFin"].ToString();
    var shift = Context.Request.Query["shift"].ToString();
    var navire = Context.Request.Query["navire"].ToString();
    var ligneMaritime = Context.Request.Query["ligneMaritime"].ToString();
    var quai = Context.Request.Query["quai"].ToString();
    var typeIncident = Context.Request.Query["typeIncident"].ToString();

    // TagBuilder.InnerHtml.Append encode value/label (contrairement à Html.Raw précédemment
    // utilisé ici) : ces valeurs sont aujourd'hui toujours numériques/fixes, mais ce pattern
    // reste sûr si l'une d'elles devenait un jour un texte libre.
    IHtmlContent Kpi(object value, string label)
    {
        var wrapper = new TagBuilder("div");
        wrapper.AddCssClass("rounded-xl border border-slate-200 bg-slate-50/60 p-4 text-center");

        var valueDiv = new TagBuilder("div");
        valueDiv.AddCssClass("text-2xl font-bold text-slate-900");
        valueDiv.InnerHtml.Append(value?.ToString() ?? string.Empty);

        var labelDiv = new TagBuilder("div");
        labelDiv.AddCssClass("text-xs text-slate-500 mt-1");
        labelDiv.InnerHtml.Append(label);

        wrapper.InnerHtml.AppendHtml(valueDiv);
        wrapper.InnerHtml.AppendHtml(labelDiv);
        return wrapper;
    }
}

<div class="mb-8">
    <h1 class="page-title">Reporting et indicateurs</h1>
    <p class="page-subtitle">Indicateurs transverses filtrables</p>
</div>

<section class="card mb-6">
    <form method="get" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 items-end">
        <div><label class="field-label">Du</label><input type="date" name="dateDebut" value="@dateDebut" class="input-field" /></div>
        <div><label class="field-label">Au</label><input type="date" name="dateFin" value="@dateFin" class="input-field" /></div>
        <div>
            <label class="field-label">Shift</label>
            <select name="shift" class="input-field">
                <option value="">Tous</option>
                @foreach (var s in Model.ShiftsDisponibles) { <option value="@s" selected="@(s == shift)">@s</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Navire</label>
            <select name="navire" class="input-field">
                <option value="">Tous</option>
                @foreach (var n in Model.NaviresDisponibles) { <option value="@n" selected="@(n == navire)">@n</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Ligne maritime</label>
            <select name="ligneMaritime" class="input-field">
                <option value="">Toutes</option>
                @foreach (var l in Model.LignesDisponibles) { <option value="@l" selected="@(l == ligneMaritime)">@l</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Quai</label>
            <select name="quai" class="input-field">
                <option value="">Tous</option>
                @foreach (var q in Model.QuaisDisponibles) { <option value="@q" selected="@(q == quai)">@q</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Type d'incident</label>
            <select name="typeIncident" class="input-field">
                <option value="">Tous</option>
                @foreach (var c in Model.CategoriesIncidentDisponibles) { <option value="@c" selected="@(c == typeIncident)">@c</option> }
            </select>
        </div>
        <div><button type="submit" class="btn-primary w-full">Filtrer</button></div>
    </form>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Escales</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Kpi(Model.NombreEscales, "Escales sur la période")
        @Kpi(Model.NombreEscalesTerminees, "Escales terminées")
        @Kpi(Model.NombreEscalesAvecAnomalies, "Escales avec anomalies")
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Anomalies et incidents</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-4">
        @Kpi(Model.NombreConteneursEnAnomalie, "Conteneurs en anomalie")
        @Kpi(Model.DelaiMoyenResolutionAnomaliesHeures is { } d ? $"{d:0.0} h" : "—", "Délai moyen de résolution")
        @Kpi(Model.NombreIncidentsCritiques, "Incidents critiques")
        @Kpi($"{Model.DureeTotaleIncidentsHeures:0.0} h", "Durée totale des incidents")
    </div>
    @if (Model.IncidentsParCategorie.Any())
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var (categorie, nombre) in Model.IncidentsParCategorie)
            {
                <span class="badge-neutral">@categorie : @nombre</span>
            }
        </div>
    }
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Équipements</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-4">
        @Kpi($"{Model.DisponibiliteStsPct}%", "Disponibilité STS")
        @Kpi($"{Model.DisponibiliteTtPct}%", "Disponibilité TT")
        @Kpi($"{Model.DisponibiliteRtgPct}%", "Disponibilité RTG")
        @Kpi($"{Model.DisponibiliteAutresEnginsPct}%", "Disponibilité autres engins")
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Kpi(Model.NombrePannes, "Nombre de pannes")
        @Kpi($"{Model.DureeTotalePannesHeures:0.0} h", "Durée totale des pannes")
        @Kpi($"{Model.TauxAffectationEquipementsPct}%", "Taux d'affectation")
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Conteneurs vides, additionnels et dangereux</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        @Kpi(Model.ConteneursVidesSouhaites, "Vides souhaités")
        @Kpi(Model.ConteneursVidesEmbarques, "Vides embarqués")
        @Kpi(Model.ConteneursVidesCoupes, "Vides coupés")
        @Kpi(Model.ConteneursVidesRestants, "Vides restants")
        @Kpi(Model.NombreConteneursAdditionnels, "Additionnels")
        @Kpi(Model.NombreConteneursDangereux, "Dangereux")
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Cargo et rapports</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        @Kpi($"{Model.TauxRealisationDischPct}%", "Réalisation Disch")
        @Kpi($"{Model.TauxRealisationLoadPct}%", "Réalisation Load")
        @Kpi(Model.DelaiMoyenProductionRapportsHeures is { } r ? $"{r:0.0} h" : "—", "Délai moyen de production des rapports")
        @Kpi(Model.NombreRapportsEnvoyes, "Rapports envoyés")
    </div>
</section>

<section class="card">
    <h2 class="card-title mb-4">ITT et Yard</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Kpi(Model.NombreTransfertsItt, "Transferts ITT")
        @Kpi($"{Model.TauxAvancementTransfertsPct:0.0}%", "Avancement des transferts")
        @Kpi(Model.NombreTachesYardRealisees, "Tâches Yard réalisées")
    </div>
</section>
