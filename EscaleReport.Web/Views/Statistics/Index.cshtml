@using EscaleReport.Web.Application.Statistics.Queries.GetIndicators
@model IndicatorsResultDto
@{
    ViewData["Title"] = "Reporting et indicateurs";
    var dateDebut = Context.Request.Query["dateDebut"].ToString();
    var dateFin = Context.Request.Query["dateFin"].ToString();
    var shift = Context.Request.Query["shift"].ToString();
    var navire = Context.Request.Query["navire"].ToString();
    var ligneMaritime = Context.Request.Query["ligneMaritime"].ToString();
    var quai = Context.Request.Query["quai"].ToString();
    var typeIncident = Context.Request.Query["typeIncident"].ToString();

    string Kpi(object value, string label) => $@"<div class=""rounded-xl border border-slate-200 bg-slate-50/60 p-4 text-center""><div class=""text-2xl font-bold text-slate-900"">{value}</div><div class=""text-xs text-slate-500 mt-1"">{label}</div></div>";
}

<div class="mb-8">
    <h1 class="page-title">Reporting et indicateurs</h1>
    <p class="page-subtitle">Indicateurs transverses filtrables — CDC §17</p>
</div>

<section class="card mb-6">
    <form method="get" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 items-end">
        <div><label class="field-label">Du</label><input type="date" name="dateDebut" value="@dateDebut" class="input-field" /></div>
        <div><label class="field-label">Au</label><input type="date" name="dateFin" value="@dateFin" class="input-field" /></div>
        <div>
            <label class="field-label">Shift</label>
            <select name="shift" class="input-field">
                <option value="">Tous</option>
                @foreach (var s in Model.ShiftsDisponibles) { <option value="@s" selected="@(s == shift)">@s</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Navire</label>
            <select name="navire" class="input-field">
                <option value="">Tous</option>
                @foreach (var n in Model.NaviresDisponibles) { <option value="@n" selected="@(n == navire)">@n</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Ligne maritime</label>
            <select name="ligneMaritime" class="input-field">
                <option value="">Toutes</option>
                @foreach (var l in Model.LignesDisponibles) { <option value="@l" selected="@(l == ligneMaritime)">@l</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Quai</label>
            <select name="quai" class="input-field">
                <option value="">Tous</option>
                @foreach (var q in Model.QuaisDisponibles) { <option value="@q" selected="@(q == quai)">@q</option> }
            </select>
        </div>
        <div>
            <label class="field-label">Type d'incident</label>
            <select name="typeIncident" class="input-field">
                <option value="">Tous</option>
                @foreach (var c in Model.CategoriesIncidentDisponibles) { <option value="@c" selected="@(c == typeIncident)">@c</option> }
            </select>
        </div>
        <div><button type="submit" class="btn-primary w-full">Filtrer</button></div>
    </form>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Escales</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Html.Raw(Kpi(Model.NombreEscales, "Escales sur la période"))
        @Html.Raw(Kpi(Model.NombreEscalesTerminees, "Escales terminées"))
        @Html.Raw(Kpi(Model.NombreEscalesAvecAnomalies, "Escales avec anomalies"))
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Anomalies et incidents</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-4">
        @Html.Raw(Kpi(Model.NombreConteneursEnAnomalie, "Conteneurs en anomalie"))
        @Html.Raw(Kpi(Model.DelaiMoyenResolutionAnomaliesHeures is { } d ? $"{d:0.0} h" : "—", "Délai moyen de résolution"))
        @Html.Raw(Kpi(Model.NombreIncidentsCritiques, "Incidents critiques"))
        @Html.Raw(Kpi($"{Model.DureeTotaleIncidentsHeures:0.0} h", "Durée totale des incidents"))
    </div>
    @if (Model.IncidentsParCategorie.Any())
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var (categorie, nombre) in Model.IncidentsParCategorie)
            {
                <span class="badge-neutral">@categorie : @nombre</span>
            }
        </div>
    }
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Équipements</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-4">
        @Html.Raw(Kpi($"{Model.DisponibiliteStsPct}%", "Disponibilité STS"))
        @Html.Raw(Kpi($"{Model.DisponibiliteTtPct}%", "Disponibilité TT"))
        @Html.Raw(Kpi($"{Model.DisponibiliteRtgPct}%", "Disponibilité RTG"))
        @Html.Raw(Kpi($"{Model.DisponibiliteAutresEnginsPct}%", "Disponibilité autres engins"))
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Html.Raw(Kpi(Model.NombrePannes, "Nombre de pannes"))
        @Html.Raw(Kpi($"{Model.DureeTotalePannesHeures:0.0} h", "Durée totale des pannes"))
        @Html.Raw(Kpi($"{Model.TauxAffectationEquipementsPct}%", "Taux d'affectation"))
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Conteneurs vides, additionnels et dangereux</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        @Html.Raw(Kpi(Model.ConteneursVidesSouhaites, "Vides souhaités"))
        @Html.Raw(Kpi(Model.ConteneursVidesEmbarques, "Vides embarqués"))
        @Html.Raw(Kpi(Model.ConteneursVidesCoupes, "Vides coupés"))
        @Html.Raw(Kpi(Model.ConteneursVidesRestants, "Vides restants"))
        @Html.Raw(Kpi(Model.NombreConteneursAdditionnels, "Additionnels"))
        @Html.Raw(Kpi(Model.NombreConteneursDangereux, "Dangereux"))
    </div>
</section>

<section class="card mb-6">
    <h2 class="card-title mb-4">Cargo et rapports</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        @Html.Raw(Kpi($"{Model.TauxRealisationDischPct}%", "Réalisation Disch"))
        @Html.Raw(Kpi($"{Model.TauxRealisationLoadPct}%", "Réalisation Load"))
        @Html.Raw(Kpi(Model.DelaiMoyenProductionRapportsHeures is { } r ? $"{r:0.0} h" : "—", "Délai moyen de production des rapports"))
        @Html.Raw(Kpi(Model.NombreRapportsEnvoyes, "Rapports envoyés"))
    </div>
</section>

<section class="card">
    <h2 class="card-title mb-4">ITT et Yard</h2>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        @Html.Raw(Kpi(Model.NombreTransfertsItt, "Transferts ITT"))
        @Html.Raw(Kpi($"{Model.TauxAvancementTransfertsPct:0.0}%", "Avancement des transferts"))
        @Html.Raw(Kpi(Model.NombreTachesYardRealisees, "Tâches Yard réalisées"))
    </div>
</section>
