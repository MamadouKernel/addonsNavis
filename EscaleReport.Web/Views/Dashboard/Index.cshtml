@model RoleDashboardViewModel
@{
    ViewData["Title"] = "Accueil";
}

<section class="mb-8 overflow-hidden rounded-3xl p-6 sm:p-8" style="background:linear-gradient(135deg,var(--ink),var(--steel));color:white;box-shadow:var(--shadow-soft)">
    <div class="max-w-3xl">
        <span class="mb-4 inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider" style="background:rgba(255,255,255,.14)">@Model.RoleLabel</span>
        <h1 class="text-2xl font-black sm:text-4xl">@Model.Heading</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 sm:text-base" style="color:rgba(255,255,255,.78)">@Model.Introduction</p>
        @if (!string.IsNullOrWhiteSpace(Model.Poste))
        {
            <p class="mt-4 text-sm"><strong>Poste actif :</strong> @Model.Poste</p>
        }
    </div>
</section>

<div class="mb-5 flex items-end justify-between gap-4">
    <div><h2 class="page-title">Priorités métier</h2><p class="page-subtitle">Les raccourcis les plus utiles pour votre rôle.</p></div>
</div>

@if (Model.PrimaryActions.Count == 0)
{
    <div class="empty-state"><h2>Aucun module disponible</h2><p>Votre compte est actif, mais aucune permission métier ne lui est encore attribuée. Contactez un administrateur.</p></div>
}
else
{
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var item in Model.PrimaryActions)
        {
            <a asp-controller="@item.Controller" asp-action="@item.Action" class="group rounded-2xl border p-5 transition hover:-translate-y-1" style="background:var(--card);border-color:var(--line);box-shadow:var(--shadow-soft)">
                <span class="mb-5 grid h-11 w-11 place-items-center rounded-xl text-lg font-black" style="background:var(--sea-soft);color:var(--sea-dark)" aria-hidden="true">@Icon(item.Icon)</span>
                <strong class="block text-lg" style="color:var(--ink)">@item.Title</strong>
                <span class="mt-2 block text-sm leading-6" style="color:var(--text-soft)">@item.Description</span>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold" style="color:var(--sea-dark)">Ouvrir <span aria-hidden="true">→</span></span>
            </a>
        }
    </div>
}

@if (Model.OtherActions.Count > 0)
{
    <section class="mt-10">
        <h2 class="mb-4 text-lg font-bold" style="color:var(--ink)">Autres outils autorisés</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in Model.OtherActions)
            {
                <a asp-controller="@item.Controller" asp-action="@item.Action" class="flex items-center gap-3 rounded-xl border p-4 transition hover:-translate-y-0.5" style="background:var(--card);border-color:var(--line)">
                    <span class="grid h-9 w-9 flex-none place-items-center rounded-lg font-bold" style="background:var(--surface);color:var(--sea-dark)" aria-hidden="true">@Icon(item.Icon)</span>
                    <span><strong class="block text-sm" style="color:var(--ink)">@item.Title</strong><small style="color:var(--text-soft)">@item.Description</small></span>
                </a>
            }
        </div>
    </section>
}

@functions {
    private static string Icon(string name) => name switch
    {
        "ship" => "⚓", "crane" => "⌁", "truck" => "▰", "grid" => "▦", "tool" => "◇",
        "switch" => "⇄", "box" => "▣", "yard" => "▥", "transfer" => "⇆", "radar" => "◎",
        "bell" => "◉", "report" => "▤", "chart" => "↗", "users" => "♟", "settings" => "⚙",
        "history" => "◷", _ => "→"
    };
}
