@model ProfileViewModel
@{
    ViewData["Title"] = "Mon profil";

    // Deux formulaires indépendants partagent le même ModelState : un résumé "asp-validation-summary=All"
    // afficherait les erreurs de l'un dans la carte de l'autre. On ne montre donc, dans chaque carte,
    // que les erreurs dont la clé commence par le préfixe du formulaire correspondant.
    IEnumerable<string> ErrorsFor(string prefix) => ViewData.ModelState
        .Where(kv => kv.Key.StartsWith(prefix, StringComparison.Ordinal))
        .SelectMany(kv => kv.Value!.Errors)
        .Select(e => e.ErrorMessage);
}

<div class="mb-8">
    <h1 class="page-title">Mon profil</h1>
    <p class="page-subtitle">Informations de votre compte et sécurité</p>
</div>

<div class="grid grid-cols-1 gap-6">
    <section class="card">
        <h2 class="card-title mb-1">Informations du compte</h2>
        <p class="card-subtitle mb-4">L'identifiant et le rôle sont gérés par un Administrateur (page Comptes &amp; permissions).</p>

        <dl class="mb-4 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
                <dt style="color:var(--text-soft)">Identifiant</dt>
                <dd class="font-semibold" style="color:var(--ink)">@Model.UserName</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
                <dt style="color:var(--text-soft)">Rôle</dt>
                <dd><span class="badge-brand">@Model.Role</span></dd>
            </div>
        </dl>

        @{ var updateProfileErrors = ErrorsFor("UpdateProfile").ToList(); }
        @if (updateProfileErrors.Count > 0)
        {
            <div class="alert-error mb-4">
                <ul>
                    @foreach (var error in updateProfileErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        <form asp-controller="Profile" asp-action="UpdateProfile" method="post" class="space-y-4">
            <div>
                <label asp-for="UpdateProfile.Email" class="field-label"></label>
                <input asp-for="UpdateProfile.Email" class="input-field" />
            </div>
            <div>
                <label asp-for="UpdateProfile.PosteParDefaut" class="field-label"></label>
                <select asp-for="UpdateProfile.PosteParDefaut" class="input-field">
                    <option value="">—</option>
                    @foreach (var p in Model.DispatchPosts)
                    {
                        <option value="@p" selected="@(p == Model.UpdateProfile.PosteParDefaut)">@p</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="UpdateProfile.Equipe" class="field-label"></label>
                <select asp-for="UpdateProfile.Equipe" class="input-field">
                    <option value="">Sans équipe</option>
                    @foreach (var team in Model.AvailableTeams)
                    {
                        <option value="@team" selected="@(team == Model.UpdateProfile.Equipe)">@team</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary w-full">Enregistrer</button>
        </form>

        @if (Model.TeamHistory.Any())
        {
            <div class="team-history mt-5">
                <h3>Historique de mes équipes</h3>
                <ol>
                    @foreach (var change in Model.TeamHistory)
                    {
                        <li><i aria-hidden="true"></i><div><strong>@change.PreviousTeam → @change.NewTeam</strong><small>@change.DateUtc.ToString("dd/MM/yyyy HH:mm") UTC · par @change.ChangedBy</small></div></li>
                    }
                </ol>
            </div>
        }
    </section>

    <section class="card">
        <h2 class="card-title mb-1">Apparence</h2>
        <p class="card-subtitle mb-4">Choisissez la palette de couleurs de l'interface (clair et sombre s'adaptent automatiquement).</p>

        <div class="flex flex-wrap gap-3">
            @{
                var currentPalette = PaletteCatalog.FromCookie(Context.Request.Cookies["palette"]);
            }
            @foreach (var p in PaletteCatalog.All)
            {
                var isActive = p.Key == currentPalette;
                <form asp-controller="Theme" asp-action="SetPalette" method="post">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <input type="hidden" name="palette" value="@p.Key" />
                    <button type="submit"
                            class="flex items-center gap-2 rounded-xl border px-3 py-2 text-sm font-medium transition"
                            style="border-color:@(isActive ? "var(--sea)" : "var(--line)"); background:@(isActive ? "var(--surface)" : "var(--card)"); color:var(--ink)"
                            aria-pressed="@(isActive ? "true" : "false")"
                            title="Palette @p.Label">
                        <span class="h-4 w-4 flex-none rounded-full" style="background:@p.SwatchHex; box-shadow: 0 0 0 2px var(--card), 0 0 0 3px @(isActive ? "var(--sea)" : "transparent")"></span>
                        @p.Label
                    </button>
                </form>
            }
        </div>
    </section>
</div>
