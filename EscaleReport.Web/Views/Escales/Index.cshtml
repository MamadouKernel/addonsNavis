@using EscaleReport.Web.Application.Common.Models
@using EscaleReport.Web.Application.Escales.Dtos
@using EscaleReport.Web.Domain.Escales
@model PagedResult<EscaleDto>
@{
    ViewData["Title"] = "Escales";

    static string OpsLabel(StatutOperations s) => s switch
    {
        StatutOperations.EnCours => "En cours",
        StatutOperations.Terminees => "Terminée",
        _ => "Pas encore débutée"
    };
    static string OpsCardClass(StatutOperations s) => s switch
    {
        StatutOperations.Terminees => "ops-term",
        StatutOperations.PasEncoreDebutees => "ops-pas",
        _ => ""
    };
    static string OpsBadgeClass(StatutOperations s) => s switch
    {
        StatutOperations.Terminees => "badge-success",
        StatutOperations.PasEncoreDebutees => "badge-neutral",
        _ => "badge-warning"
    };
    static string PlanifLabel(StatutPlanification s) => s switch
    {
        StatutPlanification.Planifie => "Planifié",
        StatutPlanification.PlanValide => "Plan validé",
        _ => "Non planifié"
    };
}

<div class="mb-6 overflow-hidden rounded-2xl sm:mb-8" style="box-shadow: var(--shadow-soft)">
    @await Html.PartialAsync("_PortScene")
</div>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4 sm:mb-8">
    <div>
        <h1 class="page-title">Tableau de bord des escales</h1>
        <p class="page-subtitle">Vue d'ensemble des navires à venir, en cours et terminés.</p>
    </div>
    <a asp-action="Create" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        Nouvelle escale
    </a>
</div>

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div class="inline-flex rounded-xl bg-slate-100 p-1" role="tablist" aria-label="Statut des escales">
        <a asp-action="Index" asp-route-view="actives" asp-route-search="@ViewBag.Search"
           class="rounded-lg px-4 py-2 text-sm font-semibold @(ViewBag.CurrentView == "actives" ? "bg-white shadow-sm text-slate-900" : "text-slate-500")">
            En cours et à venir
        </a>
        <a asp-action="Index" asp-route-view="terminees" asp-route-search="@ViewBag.Search"
           class="rounded-lg px-4 py-2 text-sm font-semibold @(ViewBag.CurrentView == "terminees" ? "bg-white shadow-sm text-slate-900" : "text-slate-500")">
            Terminées
        </a>
    </div>
    <form asp-action="Index" method="get" class="flex w-full gap-2 sm:w-auto">
        <input type="hidden" name="view" value="@ViewBag.CurrentView" />
        <label class="sr-only" for="escale-search">Rechercher une escale</label>
        <input id="escale-search" name="search" value="@ViewBag.Search"
               placeholder="Navire, voyage, quai ou ligne"
               class="input-field min-w-0 flex-1 sm:w-72" />
        <button type="submit" class="btn-secondary">Rechercher</button>
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="table-shell p-10 text-center" style="color:var(--text-soft)">
        @(Model.TotalCount == 0 ? "Aucune escale. Créez la première fiche pour commencer." : "Aucune escale sur cette page.")
    </div>
}
else
{
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var e in Model.Items)
        {
            <a asp-action="Details" asp-route-id="@e.Id" class="esc-card no-underline @OpsCardClass(e.StatutOperations)">
                <div class="flex items-start justify-between gap-2 pl-2">
                    <span class="text-base font-extrabold leading-tight" style="color:var(--ink)">@e.Navire</span>
                    <span class="@OpsBadgeClass(e.StatutOperations) whitespace-nowrap">@OpsLabel(e.StatutOperations)</span>
                </div>
                <div class="pl-2 text-sm font-semibold" style="color:var(--steel-2)">
                    @e.Voyage · @e.LigneMaritime
                </div>
                <div class="pl-2 text-xs" style="color:var(--text-soft)">
                    ETA @(e.Eta == default ? "—" : e.Eta.ToString("dd/MM/yy HH:mm"))
                    @if (!string.IsNullOrEmpty(e.Quai)) { <text> · Quai @e.Quai</text> }
                </div>
                <div class="mt-1 flex flex-wrap gap-1.5 pl-2">
                    <span class="badge-neutral">@PlanifLabel(e.StatutPlanification)</span>
                    @if (e.IsDraft)
                    {
                        <span class="badge-warning">Brouillon</span>
                    }
                    else
                    {
                        <span class="badge-success">Complète</span>
                    }
                    <span class="badge-danger">@e.AnomaliesNonResoluesCount anomalie(s)</span>
                    <span class="badge-info">@e.AdditionnelsCount additionnel(s)</span>
                </div>
            </a>
        }
    </div>
    @await Html.PartialAsync("_Pagination", PaginationViewModel.For(Model))
}
